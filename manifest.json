{
  "manifest_version": 3,
  "name": "Aurora Pulse – Tab Visualizer",
  "version": "0.2.0",
  "description": "Real-time visualizer driven by the current tab's audio.",
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
